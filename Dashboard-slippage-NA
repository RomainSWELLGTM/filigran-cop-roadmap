<script>
/*
 * PASSWORD GATE
 * The hash is SHA-256 of the password. To change the password:
 *   1. Open browser console
 *   2. Run: crypto.subtle.digest('SHA-256', new TextEncoder().encode('YOUR_NEW_PASSWORD')).then(h => console.log([...new Uint8Array(h)].map(b=>b.toString(16).padStart(2,'0')).join('')))
 *   3. Replace the hash below
 *
 * Current password: filigran2026
 */
// Password hash is stored in EXPECTED below

async function sha256(str) {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
  return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2, '0')).join('');
}

// Pre-computed hash for "filigran2026"
const EXPECTED = 'cdc66a378f8e2a08461e27434f4bd8c9869834ac5b6cd82857db8db99c47a22a';

async function tryAccess() {
  const input = document.getElementById('pwd').value;
  const hash = await sha256(input);
  if (hash === EXPECTED) {
    document.getElementById('gate').classList.add('hidden');
    document.getElementById('dashboard').classList.add('visible');
    setTimeout(() => { document.getElementById('gate').style.display = 'none'; initCharts(); }, 400);
  } else {
    document.getElementById('err').textContent = 'Invalid access code';
    document.getElementById('pwd').value = '';
    document.getElementById('pwd').focus();
  }
}

document.getElementById('pwd').addEventListener('keydown', e => { if (e.key === 'Enter') tryAccess(); });

function initCharts() {
